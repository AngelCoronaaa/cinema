# Streambert server configuration. Copy to .env and fill in.
# These values are shared by everyone who uses this server.

# TMDB Read Access Token (required) — https://www.themoviedb.org/settings/api
TMDB_TOKEN=

# Subtitle search/download (optional). SubDL is used instead of Wyzie when set.
# WYZIE_API_KEY=
# SUBDL_API_KEY=

# PORT=3210
# HOST=127.0.0.1            # 0.0.0.0 to allow other devices on your network
# STREAMBERT_TOKEN=         # access token for network access (auto-generated if empty)
# STREAMBERT_DATA_DIR=      # default ~/.streambert-web
